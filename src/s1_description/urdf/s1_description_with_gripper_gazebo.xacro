<?xml version="1.0" encoding="utf-8"?>
<!-- s1_description_no_gripper_gazebo.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="s1_description">

  <!-- ======== 1. World Link (Fixed to Base) ======== -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/> 
  </joint>

  <!-- ======== 2. LINKS ======== -->

  <!-- 增加了底座质量至 10.5kg，确保机械臂运动时底座稳如泰山 -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0038 0 -0.0081" rpy="0 0 0"/>
      <mass value="10.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/base_link.STL"/>
      </geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="1_Link">
    <inertial>
      <origin xyz="0 -0.000005 0.059" rpy="0 0 0"/>
      <mass value="0.24"/>
      <inertia ixx="0.00018" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00016"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/1_Link.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/1_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="2_Link">
    <inertial>
      <origin xyz="-0.25 0.0005 0" rpy="0 0 0"/>
      <mass value="0.27"/>
      <inertia ixx="0.00016" ixy="0" ixz="0" iyy="0.00096" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/2_Link.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/2_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="3_Link">
    <inertial>
      <origin xyz="0.19 -0.0036 0.056" rpy="0 0 0"/>
      <mass value="0.196"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00036" iyz="0" izz="0.00035"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/3_Link.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/3_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="4_Link">
    <inertial>
      <origin xyz="0.068 0.0025 0.048" rpy="0 0 0"/>
      <mass value="0.16"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00021" iyz="0" izz="0.00015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/4_Link.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/4_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="5_Link">
    <inertial>
      <origin xyz="0.0009 0 -0.055" rpy="0 0 0"/>
      <mass value="0.148"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/5_Link.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/5_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- 提高了 Link 6 质量至 0.1kg，防止物理引擎崩溃 -->
  <link name="6_Link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0.02 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0 0" rpy="0 1.57 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/flange.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0 0" rpy="0 1.57 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/flange.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ======== 3. JOINTS ======== -->

  <joint name="1joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="1_Link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="9" velocity="3"/>
  </joint>

  <joint name="2joint" type="revolute">
    <origin xyz="0 0 0.06525" rpy="0 0 0"/>
    <parent link="1_Link"/>
    <child link="2_Link"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14" effort="9" velocity="3"/>
  </joint>

  <joint name="3joint" type="revolute">
    <origin xyz="-0.3 0.000495 0" rpy="0 0 0"/>
    <parent link="2_Link"/>
    <child link="3_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="3.14" effort="9" velocity="3"/>
  </joint>

  <joint name="4joint" type="revolute">
    <origin xyz="0.22 -0.000495 0.057" rpy="0 0 0"/>
    <parent link="3_Link"/>
    <child link="4_Link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.518" effort="3" velocity="3"/>
  </joint>

  <joint name="5joint" type="revolute">
    <origin xyz="0.080787 0 0.059173" rpy="0 0 0"/>
    <parent link="4_Link"/>
    <child link="5_Link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.57" upper="1.57" effort="3" velocity="3"/>
  </joint>

  <joint name="6joint" type="revolute">
    <origin xyz="0.031212 0 -0.059174" rpy="0 0 0"/>
    <parent link="5_Link"/>
    <child link="6_Link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="3" velocity="3"/>
  </joint>

  <!-- ======== 夹爪 Links & Joints ======== -->

  <link name="gripper_base">
    <inertial>
      <origin xyz="0.0626 0 0.0004" rpy="0 0 0"/>
      <mass value="0.191"/>
      <inertia ixx="0.000155" ixy="0" ixz="0"
               iyy="0.000057" iyz="0" izz="0.000139"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/6_Link.STL"/>
      </geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/6_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint6_to_gripper_base" type="fixed">
    <origin xyz="-0.029927 0 0" rpy="0 0 0"/>
    <parent link="6_Link"/>
    <child link="gripper_base"/>
  </joint>

  <link name="7_1_Link">
    <inertial>
      <origin xyz="0 -0.016 0.016" rpy="0 0 0"/>
      <mass value="0.0163"/>
      <inertia ixx="0.00000109" ixy="0" ixz="0"
               iyy="0.00000109" iyz="0" izz="0.00000109"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/7_1_Link.STL"/>
      </geometry>
      <material name="grey"><color rgba="0.898 0.918 0.929 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/7_1_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="7_2_Link">
    <inertial>
      <origin xyz="0 0.016 0.016" rpy="0 0 0"/>
      <mass value="0.0163"/>
      <inertia ixx="0.00000109" ixy="0" ixz="0"
               iyy="0.00000109" iyz="0" izz="0.00000109"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/7_2_Link.STL"/>
      </geometry>
      <material name="grey"><color rgba="0.898 0.918 0.929 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find s1_description)/meshes/7_2_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="7_1_joint" type="prismatic">
    <origin xyz="0.1 0.014 0.016" rpy="1.57 0 1.57"/>
    <parent link="gripper_base"/>
    <child link="7_1_Link"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.05" effort="3" velocity="3"/>
  </joint>

  <joint name="7_2_joint" type="prismatic">
    <origin xyz="0.1 -0.014 -0.016" rpy="1.57 0 1.57"/>
    <parent link="gripper_base"/>
    <child link="7_2_Link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.05" effort="3" velocity="3"/>
  </joint>

<!-- ======== 4. Gazebo Properties (带碰撞过滤) ======== -->
  
  <!-- Base Link: 设置为第一位 (0x01) -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- 1_Link: 设置为第二位 (0x02)，不与底座和 2_Link 碰撞，防止抖动 -->
  <gazebo reference="1_Link">
    <material>Gazebo/White</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x02</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- 2_Link: 设置为第一位 (0x01)，这样它会和 6_Link (也是0x01) 发生硬碰撞，挡住它 -->
  <gazebo reference="2_Link">
    <material>Gazebo/Grey</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- 3_Link: 设置为第二位 (0x02) -->
  <gazebo reference="3_Link">
    <material>Gazebo/Grey</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x02</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- 4_Link: 设置为第一位 (0x01) -->
  <gazebo reference="4_Link">
    <material>Gazebo/White</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x02</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- 5_Link: 设置为第二位 (0x02) -->
  <gazebo reference="5_Link">
    <material>Gazebo/White</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x02</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- 6_Link: 设置为第一位 (0x01)，这样它就能撞到 2_Link 和 base_link -->
  <gazebo reference="6_Link">
    <material>Gazebo/White</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- Gripper Base -->
  <gazebo reference="gripper_base">
    <material>Gazebo/White</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x02</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- Gripper Finger 1 -->
  <gazebo reference="7_1_Link">
    <material>Gazebo/Grey</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- Gripper Finger 2 -->
  <gazebo reference="7_2_Link">
    <material>Gazebo/Grey</material>
    <self_collide>true</self_collide>
    <collision>
      <surface>
        <contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- ======== 5. ros2_control ======== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- 重复关节定义并加入初始值防止加载瞬间崩溃 -->
    <xacro:macro name="joint_interface" params="name initial">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:joint_interface name="1joint" initial="0.0"/>
    <xacro:joint_interface name="2joint" initial="0.0"/>
    <xacro:joint_interface name="3joint" initial="0.0"/>
    <xacro:joint_interface name="4joint" initial="-0.1"/>
    <xacro:joint_interface name="5joint" initial="0.0"/>
    <xacro:joint_interface name="6joint" initial="0.0"/>
    <xacro:joint_interface name="7_1_joint" initial="0.0"/>
    <xacro:joint_interface name="7_2_joint" initial="0.0"/>
  </ros2_control>

  <!-- ======== 6. Gazebo ros2_control Plugin ======== -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <!-- 推荐使用 find 方式，如果还是卡死，请改回绝对路径 -->
      <parameters>$(find s1_gazebo)/config/ros2_controllers.yaml</parameters>
      <!-- <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node> -->
    </plugin>
  </gazebo>

</robot>